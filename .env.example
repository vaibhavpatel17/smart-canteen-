# Copy this file to ".env" (same folder as app.py) and fill it in. app.py reads it when it starts.
# Real environment variables win over this file. Never share or upload your .env: the secrets in it can take money out of your account.

# --- Zomato / Swiggy style payments (Razorpay) -----------------------------------------------------------------
# Start with TEST keys (they start with rzp_test_). No KYC needed, no real money moves.
# Razorpay Dashboard > switch to Test Mode > Account & Settings > API Keys > Generate Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# So an order is confirmed even if the student closes the app right after paying.
# Razorpay Dashboard > Account & Settings > Webhooks > Add. URL: https://<your public address>/api/razorpay/webhook
# Events: payment.authorized and payment.captured. Type any secret you like there and put the same one here.
RAZORPAY_WEBHOOK_SECRET=

# --- Hosting (only when it runs on a public server) -------------------------------------------------------------
# BEHIND_HTTPS_PROXY=1       set this on Fly/Render/Railway/nginx: trusts the proxy's HTTPS and sends the login cookie only over HTTPS
# CANTEEN_DB=/data/canteen.db   where the one database file lives. Put it on a persistent disk or every restart wipes it.

# --- Optional ---------------------------------------------------------------------------------------------------
# KITCHEN_PIN=7391          # choose your own kitchen PIN
# UPI_ID=yourname@okhdfcbank   # only used when NO Razorpay keys are set (manual UPI to you)
# UPI_NAME=Smart Canteen
